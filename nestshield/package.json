{
  "name": "nestshield",
  "version": "1.0.0",
  "description": "Real-time API monitoring, email alerts, and rate limiting for NestJS — zero database, zero infrastructure.",
  "author": "Pranav Deekshith <pranav.d.karanam@gmail.com>",
  "license": "MIT",
  "homepage": "https://nestshield.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/nestshield.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/nestshield/issues"
  },
  "keywords": [
    "nestjs",
    "monitoring",
    "api-monitor",
    "real-time",
    "dashboard",
    "alerts",
    "rate-limiting",
    "websocket",
    "metrics",
    "health-check",
    "nestjs-module",
    "email-alerts",
    "api-guard"
  ],
  "main": "dist/nestshield/index.js",
  "types": "dist/nestshield/index.d.ts",
  "files": [
    "dist/nestshield/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.1.17",
    "nodemailer": "^8.0.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "socket.io": "^4.6.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^7.3.1",
    "@nestjs/testing": "^11.1.17",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
